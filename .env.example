# Public Supabase configuration
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project.supabase.co

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Server-only secret. Never expose this as VITE_* and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# AI provider configuration.
# On Lovable Cloud, LOVABLE_API_KEY is created and managed automatically by the platform.
# Do not create or expose a VITE_* version of this secret.
LOVABLE_AI_MODEL=openai/gpt-5.5

# Optional fallback for deployments that do not use Lovable AI.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-model-id
OPENAI_BASE_URL=https://api.openai.com/v1


# Server-to-server product ingestion. Use a long random value and never expose it as VITE_*.
PRODUCT_INGEST_SECRET=replace-with-a-long-random-secret

# Server-side AI plan limits. Keep disabled until drizzle/migrations/0002_plan_usage.sql
# has been applied to the production Supabase database.
AI_USAGE_LIMITS_ENABLED=false
AI_FREE_MONTHLY_LIMIT=10
AI_PRO_MONTHLY_LIMIT=100

# Mercado Pago recurring billing. Keep disabled until 0002 and 0003 migrations are applied.
# This flag controls NEW checkouts only. Existing subscription webhooks keep reconciling while
# credentials remain configured, even when this flag is false.
# The monthly price is intentionally blank: choose the commercial price before enabling billing.
MERCADO_PAGO_BILLING_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret
MERCADO_PAGO_PRO_MONTHLY_BRL=
MERCADO_PAGO_PRO_REASON=RadarShop AI Pro

# Canonical public URL used as the secure checkout return URL.
APP_PUBLIC_URL=https://your-domain.com

# PayPal subscriptions. Start in sandbox and switch PAYPAL_ENVIRONMENT=live only after tests.
PAYPAL_BILLING_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_PLAN_ID=your-paypal-plan-id
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_PRO_MONTHLY_BRL=
PAYPAL_BRAND_NAME=RadarShop AI

# Pepper checkout. The hosted checkout can be offered as an alternative gateway.
# Automatic Pro activation remains disabled until the account-specific API/Webhook contract is validated.
PEPPER_BILLING_ENABLED=false
PEPPER_CHECKOUT_URL=
PEPPER_PRO_MONTHLY_BRL=


# TikTok Shop Affiliate API.
# Keep disabled until the app is approved/allowlisted in TikTok Shop Partner Center.
# App Secret is server-only and must never be exposed as VITE_*.
TIKTOK_SHOP_AFFILIATE_ENABLED=false
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# 32 random bytes encoded as base64. Used only to encrypt Creator tokens at rest.
TIKTOK_SHOP_TOKEN_ENCRYPTION_KEY=

# FastMoss (inteligência de mercado de terceiros) — SERVER-ONLY. Nunca crie VITE_FASTMOSS_*.
FASTMOSS_API_KEY=
FASTMOSS_DEFAULT_REGION=BR
